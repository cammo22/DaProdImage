{
  "name": "daprod-image",
  "productName": "DaProd Image",
  "version": "0.2.0",
  "description": "DaProd Image: crea e modifica foto con Qwen-Image-2.1 sul tuo PC (CUDA, da 6 GB di VRAM). Turbo a 8 passi, preset per poster e infografiche, zone con anteprima dal vivo, LoRA con un clic, galleria.",
  "author": "DaProd",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/cammo22/DaProdImage.git" },
  "homepage": "https://github.com/cammo22/DaProdImage",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "prendi-uv": "node scripts/prendi-uv.mjs",
    "dist": "npm run prendi-uv && npm run build && electron-builder --win --x64",
    "prova": "node test/prove.mjs",
    "foto": "node test/foto.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron@44.6.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
